        }
      }
    },
    "privacy.share.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only vehicle identification involves a third party, and only for the photo being analyzed. Nothing is sold, rented or shared for advertising purposes. Apple handles subscription payments; we never see your payment details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule l'identification des véhicules fait intervenir un tiers, et uniquement pour la photo analysée. Rien n'est vendu, loué ni partagé à des fins publicitaires. Apple gère les paiements d'abonnement ; nous ne voyons jamais tes coordonnées bancaires."
          }
        }
      }
    },
