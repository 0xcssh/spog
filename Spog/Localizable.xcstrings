    "paywall.legal.plain %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment is charged to your Apple ID at confirmation. Your subscription renews automatically at %@ per month, or %@ per year, unless auto-renew is turned off at least 24 hours before the end of the period. Manage it in your Apple account."
          }
        },
        "fr": {
          "stringUnit": {
