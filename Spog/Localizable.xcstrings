    "training.ask.decline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No thanks"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non merci"
          }
        }
      }
    },
    "training.ask.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With your permission, the photos of your catches are kept, with plates blurred, to train recognition that runs right on your iPhone: faster, and even offline. No identity is attached, and you can change your mind at any time in Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec ton accord, les photos de tes prises sont conservÃ©es, plaques floutÃ©es, pour entraÃ®ner une reconnaissance qui marchera directement sur ton iPhone : plus rapide, et mÃªme sans rÃ©seau. Aucune identitÃ© n'y est rattachÃ©e, et tu peux changer d'avis Ã  tout moment dans les rÃ©glages."
          }
        }
      }
    },
    "training.ask.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help Spog recognize cars?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aider Spog Ã  reconnaÃ®tre les voitures ?"
          }
        }
      }
    }
  },
