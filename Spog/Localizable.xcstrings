    "privacy.keep.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cards and photos stay on your device for as long as you keep them. Removing a card from the garage deletes its photos immediately and permanently, and removes it from the leaderboards too. Catches recorded for the leaderboards are kept on our server for as long as your account exists; deleting it, in Settings, erases everything. Your referral code, any code you entered, and the vehicles the app has learned from your scans live on your device, and go away with the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes cartes et tes photos restent sur ton appareil aussi longtemps que tu les gardes. Retirer une carte du garage supprime ses photos immÃ©diatement et dÃ©finitivement, et la retire aussi des classements. Les prises enregistrÃ©es pour les classements sont conservÃ©es sur notre serveur tant que ton compte existe ; le supprimer, dans les rÃ©glages, efface tout. Ton code de parrainage, celui que tu as Ã©ventuellement saisi, et les vÃ©hicules que l'app a appris de tes scans vivent sur ton appareil, et disparaissent avec elle."
          }
        }
      }
    },
    "privacy.keep.title": {
      "extractionState": "manual",
