{
  "sourceLanguage": "en",
  "strings": {
    "account.apple.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in with Apple didn't work. Try again in a moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion avec Apple n'a pas abouti. Réessaie dans un instant."
          }
        }
      }
    },
    "account.apple.overline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde"
          }
        }
      }
    },
    "account.apple.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never lose your collection"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne perds jamais ta collection"
          }
        }
      }
    },
    "account.benefit.backup.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your catches stay on your account, even when you switch iPhones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes prises restent sur ton compte, même si tu changes d'iPhone."
          }
        }
      }
    },
    "account.benefit.backup.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your collection, backed up"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta collection, sauvegardée"
          }
        }
      }
    },
    "account.benefit.first.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every model you spot first stays in your name."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modèle repéré en premier reste à ton nom."
          }
        }
      }
    },
    "account.benefit.first.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your firsts, credited"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes premières, créditées"
          }
        }
      }
    },
    "account.benefit.league.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your league and live duels follow you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ligue et tes duels en cours te suivent."
