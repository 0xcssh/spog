    "privacy.account.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spog requires no account, no email address and no password. Your garage lives on your device. If you delete the app, everything it contains is deleted with it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spog ne demande ni compte, ni adresse e-mail, ni mot de passe. Ton garage vit sur ton appareil. Si tu supprimes l'app, tout ce qu'elle contient est supprimé avec elle."
          }
        }
      }
    },
    "privacy.account.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte"
          }
        }
      }
    },
    "privacy.collect.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spog collects the photos you take in the app, the country you spot in, and the city name when you enable location. Nothing else. No advertising identifier, no behavioural tracking, no third-party analytics."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spog collecte les photos que tu prends dans l'app, le pays où tu repères tes voitures, et le nom de la ville si tu actives la localisation. Rien d'autre. Aucun identifiant publicitaire, aucun pistage comportemental, aucun outil de mesure tiers."
          }
        }
      }
    },
    "privacy.collect.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What Spog collects"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que Spog collecte"
          }
        }
      }
    },
    "privacy.contact.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandalore LLC — app@mandalore-group.com"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandalore LLC — app@mandalore-group.com"
          }
        }
      }
    },
    "privacy.contact.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact"
          }
        }
      }
    },
    "privacy.keep.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your cards and photos stay on your device for as long as you keep them. Removing a card from the garage deletes its photos immediately and permanently."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes cartes et tes photos restent sur ton appareil aussi longtemps que tu les gardes. Retirer une carte du garage supprime ses photos immédiatement et définitivement."
          }
        }
      }
    },
    "privacy.keep.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long data is kept"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durée de conservation"
          }
        }
      }
    },
    "privacy.photos.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are stored on your device. To identify a vehicle, a photo is sent to our server, which forwards it to an artificial-intelligence provider for analysis, then returns the result. Before any transmission, licence plates detected in the image are blurred on your device. Transmitted photos are not used to train any model and are not kept once the answer is returned."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont stockées sur ton appareil. Pour identifier un véhicule, une photo est envoyée à notre serveur, qui la transmet à un prestataire d'intelligence artificielle pour analyse, puis renvoie le résultat. Avant toute transmission, les plaques d'immatriculation détectées dans l'image sont floutées sur ton appareil. Les photos transmises ne servent à entraîner aucun modèle et ne sont pas conservées une fois la réponse rendue."
          }
        }
      }
    },
    "privacy.photos.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes photos"
          }
        }
      }
    },
    "privacy.place.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location is optional and the app works fully without it. When enabled, your position is converted immediately into a country code and a city name, then discarded. No coordinates are stored or transmitted, and no movement history is built. Permission requested is \"while using the app\" only."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La localisation est facultative et l'app fonctionne entièrement sans elle. Quand elle est active, ta position est convertie immédiatement en code pays et nom de ville, puis abandonnée. Aucune coordonnée n'est conservée ni transmise, et aucun historique de déplacements n'est constitué. L'autorisation demandée est « pendant l'utilisation » uniquement."
          }
        }
      }
    },
    "privacy.place.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Country and location"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pays et localisation"
          }
        }
      }
    },
    "privacy.rights.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Since no data is linked to an identity on our side, we hold nothing to give you access to or to delete on request. Everything is in your hands, on your device. You may withdraw location permission at any time in the iOS Settings app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune donnée n'étant rattachée à une identité de notre côté, nous ne détenons rien à te communiquer ni à effacer sur demande. Tout est entre tes mains, sur ton appareil. Tu peux retirer l'autorisation de localisation à tout moment dans les Réglages d'iOS."
          }
        }
      }
    },
    "privacy.rights.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rights"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes droits"
          }
        }
      }
    },
    "privacy.share.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only vehicle identification involves a third party, and only for the photo being analysed. Nothing is sold, rented or shared for advertising purposes. Apple handles subscription payments; we never see your payment details."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule l'identification des véhicules fait intervenir un tiers, et uniquement pour la photo analysée. Rien n'est vendu, loué ni partagé à des fins publicitaires. Apple gère les paiements d'abonnement ; nous ne voyons jamais tes coordonnées bancaires."
          }
        }
      }
    },
    "privacy.share.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Third parties"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiers"
          }
        }
      }
    },
