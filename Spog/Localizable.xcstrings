            "value": "Tu fais vivre une app indépendante"
          }
        }
      }
    },
    "paywall.unlimited.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan as much as you like and give every card a studio shot, without waiting for tomorrow."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne autant que tu veux et passe chaque carte en studio, sans attendre le lendemain."
          }
        }
      }
    },
    "paywall.unlimited.title": {
