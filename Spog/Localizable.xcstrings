    "terms.access.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spog is open to anyone aged 13 or over. Using the app requires a compatible device and, for identification, an internet connection."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spog est ouvert à toute personne âgée de 13 ans ou plus. L'utilisation nécessite un appareil compatible et, pour l'identification, une connexion internet."
          }
        }
      }
    },
    "terms.access.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès"
          }
        }
      }
    },
    "terms.accuracy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vehicle identification relies on automated analysis and can be wrong. Rarity depends on the country you spot in and reflects an editorial judgement, not an official ranking. Neither is guaranteed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identification des véhicules repose sur une analyse automatisée et peut se tromper. La rareté dépend du pays de repérage et relève d'un choix éditorial, non d'un classement officiel. Ni l'une ni l'autre ne sont garanties."
          }
        }
      }
    },
    "terms.accuracy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identification accuracy"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exactitude de l'identification"
          }
        }
      }
    },
    "terms.contact.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandalore LLC — app@mandalore-group.com"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandalore LLC — app@mandalore-group.com"
          }
        }
      }
    },
    "terms.contact.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contact"
          }
        }
      }
    },
    "terms.fairplay.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Catches must come from the live camera, aimed at a real vehicle. Photographing a screen, a magazine, a poster or a scale model is against the rules. We may remove cards obtained this way."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une prise doit venir de la caméra en direct, pointée sur un véhicule réel. Photographier un écran, un magazine, une affiche ou une maquette est contraire aux règles. Nous pouvons retirer les cartes obtenues de cette façon."
          }
        }
      }
    },
    "terms.fairplay.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fair play"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fair-play"
          }
        }
      }
    },
    "terms.object.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spog is a game. You photograph cars you come across in real life; each one becomes a collectible card in your garage. Rarity, points and levels are game mechanics with no monetary value and cannot be exchanged or resold."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spog est un jeu. Tu photographies les voitures que tu croises dans la vraie vie ; chacune devient une carte à collectionner dans ton garage. La rareté, les points et les niveaux sont des mécaniques de jeu sans valeur monétaire, non échangeables et non revendables."
          }
        }
      }
    },
    "terms.object.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purpose"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objet"
          }
        }
      }
    },
    "terms.property.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name Spog, its logo, its interface and its vehicle catalogue are the property of Mandalore LLC. Brand names and models are cited for descriptive purposes only; the brands mentioned are the property of their respective owners and are in no way associated with Spog. The photos you take remain yours."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom Spog, son logo, son interface et son catalogue de véhicules sont la propriété de Mandalore LLC. Les noms de marques et de modèles sont cités à titre descriptif uniquement ; les marques mentionnées appartiennent à leurs détenteurs respectifs et ne sont en aucun cas associées à Spog. Les photos que tu prends restent les tiennes."
          }
        }
      }
    },
    "terms.property.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Intellectual property"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Propriété intellectuelle"
          }
        }
      }
    },
    "terms.safety.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never use Spog while driving. Do not photograph from a moving vehicle, do not step onto a roadway, and respect the privacy of others: photograph cars, not people. You alone are responsible for the circumstances in which you take a photo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'utilise jamais Spog en conduisant. Ne photographie pas depuis un véhicule en mouvement, ne descends pas sur la chaussée, et respecte la vie privée d'autrui : photographie des voitures, pas des personnes. Tu es seul responsable des circonstances dans lesquelles tu prends une photo."
          }
        }
      }
    },
    "terms.safety.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Road safety"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sécurité routière"
          }
        }
      }
    },
    "terms.subscription.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some features require a paid subscription, billed through your Apple Account. It renews automatically unless cancelled at least 24 hours before the end of the current period. Manage or cancel it at any time from Settings, or from your Apple Account. Any unused portion of a free trial is forfeited when a subscription is purchased."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines fonctions nécessitent un abonnement payant, facturé via ton compte Apple. Il se renouvelle automatiquement sauf résiliation au moins 24 heures avant la fin de la période en cours. Tu peux le gérer ou le résilier à tout moment depuis les Réglages, ou depuis ton compte Apple. Toute période d'essai gratuite non utilisée est perdue en cas de souscription."
          }
        }
      }
    },
