    "account.delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete permanently"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer définitivement"
          }
        }
      }
    },
    "account.delete.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletion didn't go through. Check your connection and try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression n'a pas abouti. Vérifie ta connexion et réessaie."
          }
        }
      }
    },
    "account.delete.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your handle, your ranking and the catches stored on our server will be erased, along with any photos shared for training. The cards on this phone stay in your garage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton pseudo, ton classement et tes prises enregistrées sur notre serveur seront effacés, ainsi que les photos confiées à l'entraînement. Les cartes de ce téléphone restent dans ton garage."
          }
        }
      }
    },
    "account.delete.row": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete my account"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer mon compte"
          }
        }
      }
    },
    "account.delete.title": {
